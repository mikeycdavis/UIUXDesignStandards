{
  "name": "uiux-standards",
  "version": "1.0.0",
  "description": "Numbered UI/UX/design standards, the rule catalog they bind to, and the commands that establish whether they apply to a repository and whether that repository satisfies them.",
  "type": "module",
  "bin": { "uiux-standards": "scripts/uiux.mjs" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/uiux.mjs audit .",
    "audit:strict": "node scripts/uiux.mjs audit . --strict",
    "validate": "node scripts/uiux.mjs validate .",
    "applicability": "node scripts/uiux.mjs applicability .",
    "applicability:self": "node scripts/uiux.mjs applicability . --self",
    "policy": "node scripts/policy.mjs",
    "policy:templates": "node scripts/policy.mjs --dir=templates",
    "inventory": "node scripts/inventory.mjs",
    "rule-identity": "node scripts/rule-identity.mjs",
    "provenance": "node scripts/provenance.mjs",
    "diagrams": "node scripts/diagrams.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "ci": "node scripts/ci.mjs",
    "submit-pr": "node scripts/submit-pr.mjs"
  },
  "engines": { "node": ">=18" },
  "license": "UNLICENSED",
  "private": true
}
